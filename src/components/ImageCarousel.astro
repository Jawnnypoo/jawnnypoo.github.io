---
interface Props {
  images: string[];
  projectName: string;
}

const { images, projectName } = Astro.props;
const carouselId = `carousel-${projectName.replace(/\s+/g, '-').toLowerCase()}`;
---

<div class="carousel" id={carouselId}>
  <div class="carousel-track">
    {images.map((img, i) => (
      <button type="button" class="carousel-slide" data-full={`/images/${img}`}>
        <img
          src={`/images/${img}`}
          alt={`${projectName} screenshot ${i + 1}`}
          loading="lazy"
        />
      </button>
    ))}
  </div>
  {images.length > 1 && (
    <button class="carousel-btn prev" aria-label="Previous image">&larr;</button>
    <button class="carousel-btn next" aria-label="Next image">&rarr;</button>
  )}
  {images.length > 1 && (
    <div class="carousel-dots">
      {images.map((_, i) => (
        <button class:list={["dot", { active: i === 0 }]} data-index={i} aria-label={`Go to image ${i + 1}`} />
      ))}
    </div>
  )}
</div>

<style>
  .carousel {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-surface);
  }

  .carousel-track {
    display: flex;
    transition: transform 0.35s ease;
  }

  .carousel-slide {
    min-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: zoom-in;
  }

  .carousel-slide img {
    max-height: 520px;
    width: auto;
    max-width: 100%;
    border-radius: 10px;
    object-fit: contain;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .carousel-slide img:hover {
    transform: scale(1.02);
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-text);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1.2rem;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: background 0.2s;
    z-index: 2;
  }

  .carousel-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .prev { left: 8px; }
  .next { right: 8px; }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 0.75rem 0;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--color-border);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }

  .dot.active {
    background: var(--color-primary);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', initCarousels);

  function initCarousels() {
    document.querySelectorAll<HTMLElement>('.carousel').forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('.carousel-track');
      const slides = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-slide'));
      const dots = carousel.querySelectorAll<HTMLButtonElement>('.dot');
      const prevBtn = carousel.querySelector<HTMLButtonElement>('.prev');
      const nextBtn = carousel.querySelector<HTMLButtonElement>('.next');
      let current = 0;

      if (!track || slides.length === 0) return;

      function goTo(index: number) {
        current = Math.max(0, Math.min(index, slides.length - 1));
        track!.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, i) => d.classList.toggle('active', i === current));
      }

      prevBtn?.addEventListener('click', () => goTo(current - 1));
      nextBtn?.addEventListener('click', () => goTo(current + 1));
      dots.forEach((dot) => {
        dot.addEventListener('click', () => goTo(Number(dot.dataset.index)));
      });

      slides.forEach((slide, index) => {
        slide.addEventListener('click', () => {
          openLightbox(slides, index, goTo);
        });
      });
    });
  }

  const MORPH_NAME = 'lightbox-image';
  let lightboxEl: HTMLDivElement | null = null;
  let sourceImg: HTMLImageElement | null = null;
  let gallery: { slides: HTMLButtonElement[]; index: number; goTo: (index: number) => void } | null = null;
  let previousOverflow = '';
  let closing = false;

  function ensureLightbox(): HTMLDivElement {
    if (lightboxEl) return lightboxEl;
    const el = document.createElement('div');
    el.className = 'lightbox';
    el.setAttribute('role', 'dialog');
    el.setAttribute('aria-label', 'Screenshot viewer');
    el.setAttribute('aria-modal', 'true');
    el.setAttribute('aria-hidden', 'true');
    el.innerHTML = `
      <button type="button" class="lightbox-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M6 6 L18 18 M18 6 L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/>
        </svg>
      </button>
      <button type="button" class="lightbox-nav lightbox-prev" aria-label="Previous image">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M15 5 L8 12 L15 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </button>
      <img class="lightbox-img" alt="" />
      <button type="button" class="lightbox-nav lightbox-next" aria-label="Next image">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M9 5 L16 12 L9 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </button>
      <p class="lightbox-counter" role="status" aria-live="polite" aria-atomic="true"></p>
    `;
    el.addEventListener('click', (e) => {
      if (e.target === el) closeLightbox();
    });
    el.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
    el.querySelector('.lightbox-prev')?.addEventListener('click', () => navigateLightbox(-1));
    el.querySelector('.lightbox-next')?.addEventListener('click', () => navigateLightbox(1));
    document.addEventListener('keydown', (e) => {
      if (!el.classList.contains('open') || closing) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeLightbox();
      } else if (!e.altKey && !e.ctrlKey && !e.metaKey && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
        e.preventDefault();
        navigateLightbox(e.key === 'ArrowLeft' ? -1 : 1);
      } else if (e.key === 'Tab') {
        const buttons = Array.from(el.querySelectorAll<HTMLButtonElement>('button:not([hidden])'));
        const first = buttons[0];
        const last = buttons[buttons.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
    document.body.appendChild(el);
    lightboxEl = el;
    return el;
  }

  function showLightboxImage(index: number) {
    if (!lightboxEl || !gallery) return;
    const slide = gallery.slides[index];
    const source = slide.querySelector('img');
    const img = lightboxEl.querySelector<HTMLImageElement>('.lightbox-img');
    if (!source || !slide.dataset.full || !img) return;

    gallery.index = index;
    gallery.goTo(index);
    sourceImg = source;
    img.src = slide.dataset.full;
    img.alt = source.alt;
    lightboxEl.querySelectorAll<HTMLButtonElement>('.lightbox-nav').forEach((button) => {
      button.hidden = gallery!.slides.length < 2;
    });
    const counter = lightboxEl.querySelector('.lightbox-counter');
    if (counter) counter.textContent = `${index + 1} / ${gallery.slides.length}`;
  }

  function navigateLightbox(direction: number) {
    if (!gallery || gallery.slides.length < 2 || closing) return;
    const count = gallery.slides.length;
    showLightboxImage((gallery.index + direction + count) % count);
  }

  function openLightbox(slides: HTMLButtonElement[], index: number, goTo: (index: number) => void) {
    if (closing) return;
    const source = slides[index].querySelector('img');
    if (!source || !slides[index].dataset.full) return;
    const el = ensureLightbox();
    const img = el.querySelector<HTMLImageElement>('.lightbox-img');
    if (!img) return;
    gallery = { slides, index, goTo };
    showLightboxImage(index);
    previousOverflow = document.body.style.overflow;

    const apply = () => {
      el.classList.add('open');
      el.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      el.querySelector<HTMLButtonElement>('.lightbox-close')?.focus({ preventScroll: true });
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const vt = (document as any).startViewTransition;
    if (!reduced && typeof vt === 'function') {
      source.style.viewTransitionName = MORPH_NAME;
      img.style.viewTransitionName = MORPH_NAME;
      const transition = vt.call(document, () => {
        source.style.viewTransitionName = '';
        apply();
      });
      transition.finished.finally(() => {
        if (img) img.style.viewTransitionName = '';
      });
    } else {
      apply();
    }
  }

  function closeLightbox() {
    if (!lightboxEl?.classList.contains('open') || closing) return;
    closing = true;
    const img = lightboxEl.querySelector<HTMLImageElement>('.lightbox-img');
    const returnFocus = gallery?.slides[gallery.index];

    const apply = () => {
      lightboxEl!.classList.remove('open');
      lightboxEl!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = previousOverflow;
      returnFocus?.focus({ preventScroll: true });
      gallery = null;
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const vt = (document as any).startViewTransition;
    if (!reduced && typeof vt === 'function' && img && sourceImg) {
      const returnTo = sourceImg;
      img.style.viewTransitionName = MORPH_NAME;
      const transition = vt.call(document, () => {
        img.style.viewTransitionName = '';
        returnTo.style.viewTransitionName = MORPH_NAME;
        apply();
      });
      transition.finished.finally(() => {
        returnTo.style.viewTransitionName = '';
        sourceImg = null;
        closing = false;
      });
    } else {
      apply();
      sourceImg = null;
      closing = false;
    }
  }
</script>

<style is:global>
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 4.5rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .lightbox.open {
    display: flex;
    opacity: 1;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close,
  .lightbox-nav {
    position: fixed;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(30, 30, 30, 0.8);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    z-index: 1001;
  }

  .lightbox-close {
    top: max(1.25rem, env(safe-area-inset-top));
    left: max(1.25rem, env(safe-area-inset-left));
  }

  .lightbox-nav {
    top: calc(50% - 22px);
  }

  .lightbox-prev { left: max(1rem, env(safe-area-inset-left)); }
  .lightbox-next { right: max(1rem, env(safe-area-inset-right)); }
  .lightbox-nav[hidden] { display: none; }

  .lightbox-counter {
    position: fixed;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.22);
    transform: scale(1.05);
  }

  .lightbox-close:active,
  .lightbox-nav:active {
    transform: scale(0.96);
  }

  .lightbox-close:focus-visible,
  .lightbox-nav:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .lightbox { padding: 4.5rem 0.5rem; }
    .lightbox-prev { left: max(0.5rem, env(safe-area-inset-left)); }
    .lightbox-next { right: max(0.5rem, env(safe-area-inset-right)); }
  }

  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(lightbox-image),
    ::view-transition-new(lightbox-image) {
      animation-duration: 360ms;
      animation-timing-function: cubic-bezier(0.32, 0.72, 0, 1);
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 260ms;
      animation-timing-function: ease;
    }
  }
</style>
